{
  "name": "workspacepy",
  "displayName": "WorkspacePy",
  "description": "MATLAB-style workspace for Jupyter: variable table in a side view, object viewer beside your code. Both draggable.",
  "version": "0.3.0",
  "publisher": "workspacepy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Data Science",
    "Notebooks",
    "Visualization"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:workspacepy.viewer"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspacepy",
          "title": "WorkspacePy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "workspacepy": [
        {
          "id": "workspacepy.workspace",
          "name": "Workspace",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "workspacepy.open",
        "title": "WorkspacePy: Show Workspace"
      },
      {
        "command": "workspacepy.openViewer",
        "title": "WorkspacePy: Show Variable Viewer"
      },
      {
        "command": "workspacepy.layoutHelp",
        "title": "WorkspacePy: MATLAB Layout Help"
      },
      {
        "command": "workspacepy.reconnect",
        "title": "WorkspacePy: Reconnect to Kernel"
      },
      {
        "command": "workspacepy.openUrl",
        "title": "WorkspacePy: Connect with a URL…"
      }
    ],
    "configuration": {
      "title": "WorkspacePy",
      "properties": {
        "workspacepy.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the Workspace view automatically when a kernel runs workspacepy.start()."
        },
        "workspacepy.registryPath": {
          "type": "string",
          "default": "",
          "description": "Path of active.json written by workspacepy.start(). Empty = ~/.workspacepy/active.json (or $WORKSPACEPY_HOME)."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USER/workspacepy"
  }
}
