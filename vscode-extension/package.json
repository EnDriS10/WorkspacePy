{
  "name": "workspacepy",
  "displayName": "WorkspacePy",
  "description": "MATLAB-style workspace for Jupyter: variables on the right, object viewer below your code.",
  "version": "0.2.1",
  "publisher": "workspacepy",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Data Science", "Notebooks", "Visualization"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "workspacepy", "title": "WorkspacePy", "icon": "media/icon.svg" }
      ],
      "panel": [
        { "id": "workspacepyPanel", "title": "Variable Viewer", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "workspacepy": [
        { "id": "workspacepy.workspace", "name": "Workspace", "type": "webview" }
      ],
      "workspacepyPanel": [
        { "id": "workspacepy.viewer", "name": "Variable Viewer", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "workspacepy.open", "title": "WorkspacePy: Show Workspace" },
      { "command": "workspacepy.layoutHelp", "title": "WorkspacePy: MATLAB Layout Help" },
      { "command": "workspacepy.reconnect", "title": "WorkspacePy: Reconnect to Kernel" },
      { "command": "workspacepy.openUrl", "title": "WorkspacePy: Connect with a URL…" }
    ],
    "configuration": {
      "title": "WorkspacePy",
      "properties": {
        "workspacepy.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the Workspace view automatically when a kernel runs workspacepy.start()."
        },
        "workspacepy.registryPath": {
          "type": "string",
          "default": "",
          "description": "Path of active.json written by workspacepy.start(). Empty = ~/.workspacepy/active.json (or $WORKSPACEPY_HOME)."
        }
      }
    }
  },
  "repository": { "type": "git", "url": "https://github.com/YOUR_USER/workspacepy" }
}
